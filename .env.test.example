# Copy to .env.test and adjust if needed. .env.test itself is gitignored — nothing here is a
# real secret, but keeping it out of git means nobody has to think about that.

# --- Host ports (QA-only; chosen to never collide with a dev's local DayFlow instance) ---
QA_WEB_PORT=8280
QA_API_PORT=5100
QA_DB_PORT=5543

# --- Hostname the web/E2E layer must use — NOT localhost. See ARCHITECTURE.md §4: the DayFlow
# frontend hard-codes API calls to http://localhost:5000/api whenever the hostname is
# "localhost"/"127.0.0.1", which is dev's port, not QA's. Add this line to your hosts file once:
#   127.0.0.1   dayflow-qa.local
QA_WEB_HOST=dayflow-qa.local
QA_WEB_ORIGIN=http://dayflow-qa.local:8280

# --- Database (isolated from dev's `dayflow_db` on port 5433) ---
DB_NAME=dayflow_qa
DB_USER=dayflow_qa
DB_PASSWORD=dayflow_qa_test_only

# --- API auth secret for this stack only ---
JWT_SECRET=qa-test-only-secret-do-not-use-in-prod

# --- Where the pinned, read-only checkout of DayFlow is written (gitignored, disposable) ---
DEV_CHECKOUT_DIR=./.dev-checkout/DayFlow

# --- Derived URLs used directly by the test suites ---
API_BASE_URL=http://localhost:5100/api
E2E_BASE_URL=http://dayflow-qa.local:8280
